from __future__ import annotations

import argparse
import json
import math
import os
from collections import Counter, defaultdict
from pathlib import Path
from typing import Any, Dict, List

import numpy as np
from PIL import Image
from transformers import AutoProcessor
from transformers.models.qwen2_vl.image_processing_qwen2_vl import smart_resize

from human_lisa_qwen_v1.data_v1 import (
    _as_bool,
    _attribute,
    _pose_from_annotation,
    _sort_and_rebind,
    _valid_box,
)

from .schema_v4 import PROMPT_V4, SPECIAL_TOKENS_V4
from .targets_v4 import serialize_target_v4


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--train-ann",
        default="/root/autodl-tmp/coco/unihuman_label/coco_unihuman_train_v1.json",
    )
    parser.add_argument(
        "--train-image-root", default="/root/autodl-tmp/coco/train2017"
    )
    parser.add_argument(
        "--model", default="/root/autodl-tmp/model/Qwen3.5-4B"
    )
    parser.add_argument("--output", required=True)
    parser.add_argument("--max-length", type=int, default=5000)
    parser.add_argument("--top-k", type=int, default=64)
    return parser.parse_args()


def chat_prefix(processor: Any) -> str:
    return processor.apply_chat_template(
        [
            {
                "role": "user",
                "content": [
                    {"type": "image"},
                    {"type": "text", "text": PROMPT_V4},
                ],
            }
        ],
        tokenize=False,
        add_generation_prompt=True,
    )


def lightweight_instances(
    annotations: List[Dict[str, Any]], *, width: int, height: int
) -> tuple[List[Dict[str, Any]], Counter[str]]:
    instances: List[Dict[str, Any]] = []
    skipped: Counter[str] = Counter()
    for annotation in annotations:
        if _as_bool(annotation.get("ignore", 0)):
            skipped["ignored"] += 1
            continue
        if _as_bool(annotation.get("iscrowd", 0)):
            skipped["crowd"] += 1
            continue
        valid = annotation.get("valid") or {}
        if not _as_bool(valid.get("bboxes", 1)) or not _valid_box(annotation):
            skipped["invalid_box"] += 1
            continue
        x, y, box_width, box_height = [float(v) for v in annotation["bbox"]]
        x1 = max(0.0, min(x, float(width)))
        y1 = max(0.0, min(y, float(height)))
        x2 = max(0.0, min(x + box_width, float(width)))
        y2 = max(0.0, min(y + box_height, float(height)))
        if x2 <= x1 or y2 <= y1:
            skipped["invalid_box"] += 1
            continue
        keypoints, pose_valid = _pose_from_annotation(annotation)
        gender, gender_valid = _attribute(annotation, "gender", -1.0)
        age, age_valid = _attribute(annotation, "age", -1.0)
        instances.append(
            {
                "source_ann_id": int(annotation["id"]),
                "bbox_xyxy": [x1, y1, x2, y2],
                "area": float(
                    annotation.get("area", (x2 - x1) * (y2 - y1))
                ),
                "keypoints": keypoints,
                "pose_valid": bool(pose_valid),
                "mask": None,
                "seg_valid": False,
                "gender": int(round(gender)) if gender_valid else -1,
                "gender_valid": bool(gender_valid),
                "age": float(age) if age_valid else -1.0,
                "age_valid": bool(age_valid),
            }
        )
    return _sort_and_rebind(instances), skipped


def visual_token_count(
    height: int, width: int, *, processor: Any
) -> tuple[int, int, int]:
    image_processor = processor.image_processor
    patch = int(image_processor.patch_size)
    merge = int(image_processor.merge_size)
    factor = patch * merge
    resized_height, resized_width = smart_resize(
        height,
        width,
        factor=factor,
        min_pixels=int(image_processor.size.shortest_edge),
        max_pixels=int(image_processor.size.longest_edge),
    )
    count = (resized_height // factor) * (resized_width // factor)
    return int(count), int(resized_height), int(resized_width)


def exact_prefix_overhead(processor: Any, prefix: str) -> int:
    image = Image.new("RGB", (320, 320))
    encoded = processor(
        text=[prefix], images=[image], return_tensors="pt", padding=False
    )
    sequence_length = int(encoded["attention_mask"].sum().item())
    visual_tokens, _, _ = visual_token_count(320, 320, processor=processor)
    return sequence_length - visual_tokens


def main() -> None:
    args = parse_args()
    if args.max_length != 5000:
        raise ValueError("v4 preflight requires max_length=5000")
    payload = json.loads(Path(args.train_ann).read_text(encoding="utf-8"))
    images = list(payload.get("images", []))
    annotations = list(payload.get("annotations", []))
    image_ids = [int(image["id"]) for image in images]
    annotation_ids = [int(annotation["id"]) for annotation in annotations]
    if len(set(image_ids)) != len(image_ids):
        raise RuntimeError("duplicate image ids in training annotations")
    if len(set(annotation_ids)) != len(annotation_ids):
        raise RuntimeError("duplicate annotation ids in training annotations")
    known_image_ids = set(image_ids)
    orphan_annotations = [
        int(annotation["id"])
        for annotation in annotations
        if int(annotation["image_id"]) not in known_image_ids
    ]
    if orphan_annotations:
        raise RuntimeError(
            f"annotations reference unknown images: {orphan_annotations[:8]}"
        )
    grouped: Dict[int, List[Dict[str, Any]]] = defaultdict(list)
    for annotation in annotations:
        grouped[int(annotation["image_id"])].append(annotation)

    processor = AutoProcessor.from_pretrained(
        args.model, trust_remote_code=True
    )
    processor.tokenizer.padding_side = "right"
    existing = list(
        getattr(processor.tokenizer, "additional_special_tokens", []) or []
    )
    additions = [token for token in SPECIAL_TOKENS_V4 if token not in existing]
    if additions:
        processor.tokenizer.add_special_tokens(
            {"additional_special_tokens": existing + additions}
        )
    prefix = chat_prefix(processor)
    overhead = exact_prefix_overhead(processor, prefix)
    eos_id = int(processor.tokenizer.eos_token_id)
    image_root = Path(args.train_image_root)

    skipped_total: Counter[str] = Counter()
    label_counts: Counter[str] = Counter()
    missing_images: List[str] = []
    records: List[Dict[str, Any]] = []
    person_histogram: Counter[int] = Counter()
    max_width = 0
    max_height = 0
    max_pixels = 0

    for image in images:
        image_id = int(image["id"])
        width = int(image["width"])
        height = int(image["height"])
        if width <= 0 or height <= 0:
            raise RuntimeError(f"invalid image dimensions for {image_id}")
        path = image_root / str(image["file_name"])
        if not path.is_file():
            missing_images.append(str(path))
        instances, skipped = lightweight_instances(
            grouped.get(image_id, []), width=width, height=height
        )
        skipped_total.update(skipped)
        persons = len(instances)
        person_histogram[persons] += 1
        label_counts["persons"] += persons
        label_counts["pose"] += sum(int(x["pose_valid"]) for x in instances)
        label_counts["seg"] += sum(
            int(
                bool(grouped_annotation.get("segmentation"))
                and _as_bool(
                    (grouped_annotation.get("valid") or {}).get(
                        "segmentation", 0
                    )
                )
                and not _as_bool(grouped_annotation.get("ignore", 0))
                and not _as_bool(grouped_annotation.get("iscrowd", 0))
                and _valid_box(grouped_annotation)
            )
            for grouped_annotation in grouped.get(image_id, [])
        )
        label_counts["gender"] += sum(
            int(x["gender_valid"]) for x in instances
        )
        label_counts["age"] += sum(int(x["age_valid"]) for x in instances)
        target = serialize_target_v4(instances, width=width, height=height)
        target_ids = processor.tokenizer(
            target.text, add_special_tokens=False
        )["input_ids"]
        target_tokens = len(target_ids) + 1
        visual_tokens, resized_height, resized_width = visual_token_count(
            height, width, processor=processor
        )
        total_tokens = overhead + visual_tokens + target_tokens
        records.append(
            {
                "image_id": image_id,
                "file_name": str(image["file_name"]),
                "width": width,
                "height": height,
                "persons": persons,
                "target_tokens": target_tokens,
                "visual_tokens": visual_tokens,
                "prefix_overhead": overhead,
                "total_tokens": total_tokens,
                "resized_height": resized_height,
                "resized_width": resized_width,
            }
        )
        max_width = max(max_width, width)
        max_height = max(max_height, height)
        max_pixels = max(max_pixels, width * height)

    if missing_images:
        raise FileNotFoundError(
            f"missing {len(missing_images)} images, examples={missing_images[:8]}"
        )
    records.sort(
        key=lambda x: (x["total_tokens"], x["persons"], x["image_id"]),
        reverse=True,
    )
    top = records[: args.top_k]
    overflows = [record for record in records if record["total_tokens"] > 5000]

    exact_checks = []
    image_by_id = {int(image["id"]): image for image in images}
    for record in top[: min(16, len(top))]:
        image = image_by_id[record["image_id"]]
        instances, _ = lightweight_instances(
            grouped.get(record["image_id"], []),
            width=int(image["width"]),
            height=int(image["height"]),
        )
        target = serialize_target_v4(
            instances, width=int(image["width"]), height=int(image["height"])
        )
        text = prefix + target.text + str(processor.tokenizer.eos_token)
        blank = Image.new("RGB", (int(image["width"]), int(image["height"])))
        encoded = processor(
            text=[text], images=[blank], return_tensors="pt", padding=False
        )
        exact = int(encoded["attention_mask"].sum().item())
        exact_checks.append(
            {
                "image_id": record["image_id"],
                "estimated": record["total_tokens"],
                "exact": exact,
                "matches": exact == record["total_tokens"],
            }
        )
    if not all(item["matches"] for item in exact_checks):
        raise RuntimeError(f"visual token formula mismatch: {exact_checks}")

    summary = {
        "images": len(images),
        "annotations": len(annotations),
        "effective_persons": label_counts["persons"],
        "label_counts": dict(label_counts),
        "skipped": dict(skipped_total),
        "missing_images": len(missing_images),
        "zero_person_images": person_histogram[0],
        "max_persons": max(person_histogram, default=0),
        "person_histogram": {
            str(k): person_histogram[k] for k in sorted(person_histogram)
        },
        "max_width": max_width,
        "max_height": max_height,
        "max_source_pixels": max_pixels,
        "prefix_overhead": overhead,
        "max_target_tokens": max(x["target_tokens"] for x in records),
        "max_visual_tokens": max(x["visual_tokens"] for x in records),
        "max_total_tokens": max(x["total_tokens"] for x in records),
        "max_length": args.max_length,
        "minimum_token_headroom": args.max_length
        - max(x["total_tokens"] for x in records),
        "overflow_count": len(overflows),
        "exact_top_checks": exact_checks,
    }
    result = {"summary": summary, "top_records": top, "overflows": overflows}
    output = Path(args.output)
    output.parent.mkdir(parents=True, exist_ok=True)
    temporary = output.with_suffix(output.suffix + ".tmp")
    temporary.write_text(json.dumps(result, indent=2), encoding="utf-8")
    os.replace(temporary, output)
    print(json.dumps(summary, indent=2))
    if overflows:
        raise RuntimeError(f"found {len(overflows)} sequences above max_length")


if __name__ == "__main__":
    main()
