{
  "schema": "human-multitask-v5-config",
  "version": "v5-coco-validation",
  "sources": {
    "coco_unihuman": {
      "status": "available",
      "tasks": ["box", "pose", "segment", "age", "gender"]
    }
  },
  "sampling": {
    "strategy": "task_first_then_sqrt_dataset_size",
    "epoch_size": 64115,
    "seed": 20260901,
    "task_weights": {
      "box": 1.0,
      "pose": 1.0,
      "segment": 1.0,
      "age": 0.5,
      "gender": 0.5,
      "all": 0.5
    }
  }
}
