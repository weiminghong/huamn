  "canonical_pose": {
    "joint_count": 21,
    "coco_schema": "coco17",
    "mhp_schema": "mhp16",
    "missing_joint_target": null
  },
  "model": {
    "base": "/root/autodl-tmp/model/Qwen3.5-4B",
    "text_tasks": ["box", "pose", "age", "gender", "attribute", "relation"],
    "dense_tasks": ["segment", "parsing"],
    "dense_decoder": "hf_mask2former_modules_with_qwen_features",
    "external_rgb_encoder": false,
    "person_binding": "one_hungarian_assignment_shared_by_all_tasks"
  },
  "sampling": {
    "strategy": "task_first_then_sqrt_dataset_size",
    "epoch_size": 100000,
    "seed": 20260901,
