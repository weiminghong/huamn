      "box": 1.0,
      "pose": 1.0,
      "segment": 1.0,
      "parsing": 1.0,
      "age": 0.5,
      "gender": 0.5,
      "attribute": 0.75,
      "relation": 0.75,
      "all": 0.5
    }
  },
  "training": {
    "phases": [
      {
        "name": "decoder_interface_warmup",
        "steps": 2000,
        "qwen_vision": "frozen",
        "qwen_llm": "frozen",
        "train": ["spatial_adapter", "mask2former_decoder", "routing_rows"]
      },
      {
        "name": "joint_multisource",
        "epochs": 2,
        "qwen_vision": "lora_all_blocks",
        "qwen_merger": "full",
        "qwen_llm": "lora_attention_mlp",
        "train": ["spatial_adapter", "mask2former_decoder", "routing_rows"]
      },
      {
        "name": "balanced_finish",
        "epochs": 1,
        "learning_rate_scale": 0.2,
        "train": ["all_stage1_trainable_groups"]
      }
    ],
    "checkpoint_cadence": "recovery_only",
    "evaluation_cadence": "once_per_completed_epoch"
  }
